{
	"name": "chatbot-demo-frontend",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"minify": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Keep the app off its public workers.dev hostname and preview URLs, where
	// the Cloudflare Access application does not apply. Access is the only thing
	// standing between the internet and this UI.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "chatbot-demo.homesecurity.rocks",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "9a548800c12a4afab2b75d1afa1848bc",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
